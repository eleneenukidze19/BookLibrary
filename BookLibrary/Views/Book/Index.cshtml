@model List<BookLibrary.Models.Book>

@{
    ViewData["Title"] = "Book Library";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-4">
    <h2 class="page-title mb-0">&#128218; Book Library</h2>
    <a asp-action="Create" class="btn btn-success">+ Add New Book</a>
</div>

<div class="card p-3 mt-4">
    <form method="get" asp-action="Index" asp-controller="Book">
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <label class="form-label mb-0 me-2">Filter by genre:</label>
            <select name="genreId" class="form-select" style="max-width: 240px;">
                <option value="">All Genres</option>
                @foreach (var g in (IEnumerable<BookLibrary.Models.Genre>)ViewBag.Genres)
                {
                    <option value="@g.Id"
                            selected="@((ViewBag.SelectedGenreId as int?) == g.Id ? "selected" : null)">
                        @g.Name
                    </option>
                }
            </select>
            <button type="submit" class="btn btn-primary">Apply</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="card text-center p-5 mt-4">
        <div style="font-size: 3rem;">&#128213;</div>
        <h4 class="mt-3">No books yet</h4>
        <p class="text-muted">
            Your shelf is empty. Add your first book to get started.
        </p>
        <div>
            <a asp-action="Create" class="btn btn-primary">+ Add Your First Book</a>
        </div>
    </div>
}
else
{
    <div class="book-grid">
        @foreach (var book in Model)
        {
            <div class="card book-card">
                <h3 class="book-card__title">@book.Title</h3>
                <div class="book-card__author">by @book.Author</div>
                <div class="book-card__year">Published @book.Year</div>
                <div class="book-card__genres">
                    @foreach (var bg in book.BookGenres)
                    {
                        <span class="genre-tag">@bg.Genre.Name</span>
                    }
                </div>
                <div class="book-card__actions">
                    <form method="post" asp-action="Delete" asp-route-id="@book.Id">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm w-100"
                                onclick="return confirm('Delete this book?')">
                            &#128465; Delete
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}