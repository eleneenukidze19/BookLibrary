@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-8">
        <div class="card p-4 p-md-5">
            <h1 class="page-title">@ViewData["Title"]</h1>
            <p class="text-muted">Last updated: June 2026</p>
            <hr />
            <p>
                BookLibrary is a personal cataloging app. Your data stays on
                your device unless you explicitly export it.
            </p>
            <h4 class="mt-4">What we store</h4>
            <p>Only the book details you add: title, author, year, and genre.</p>
            <h4 class="mt-4">What we share</h4>
            <p>Nothing. There are no third-party services or trackers.</p>
        </div>
    </div>
</div>